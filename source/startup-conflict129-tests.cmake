file(READ "${CMAKE_CURRENT_SOURCE_DIR}/standalone-runtime.cpp" STARTUP129_SOURCE)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/LibertyLighting20Runtime.inc" STARTUP129_DUAL)
function(startup129_extract source begin end output)
 string(FIND "${source}" "${begin}" first)
 string(FIND "${source}" "${end}" last)
 if(first LESS 0 OR last LESS_EQUAL first)
  message(FATAL_ERROR "129 production extraction boundary absent ${begin}")
 endif()
 math(EXPR length "${last}-${first}")
 string(SUBSTRING "${source}" ${first} ${length} body)
 file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${output}" "${body}")
endfunction()
startup129_extract("${STARTUP129_SOURCE}" "std::vector<uint8_t> GuardedImage()" "uintptr_t OriginalCall(size_t rva);" startup129-normalize.inc)
startup129_extract("${STARTUP129_DUAL}" "void PrepareHooks(const std::vector<uint8_t>& image)" "void EnableHooks()" startup129-prepare.inc)
