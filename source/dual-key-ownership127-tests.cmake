file(READ "${CMAKE_CURRENT_SOURCE_DIR}/LibertyLighting20Runtime.inc" DUAL127_SOURCE)
function(dual127_extract begin end output)
  string(FIND "${DUAL127_SOURCE}" "${begin}" first)
  string(FIND "${DUAL127_SOURCE}" "${end}" last)
  if(first LESS 0 OR last LESS first)
    message(FATAL_ERROR "dual127 production boundary missing: ${begin}")
  endif()
  math(EXPR length "${last}-${first}")
  string(SUBSTRING "${DUAL127_SOURCE}" ${first} ${length} body)
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${output}" "${body}")
endfunction()
dual127_extract("__declspec(noinline) bool CopyLocal(" "bool VehicleBeam(" dual127-vehicle.inc)
dual127_extract("bool Collision(" "void Max(" dual127-publication.inc)
foreach(target IN ITEMS dual-issued-keys127 dual-key-production127)
  add_executable(${target}-tests tests/${target}-tests.cpp)
  target_include_directories(${target}-tests PRIVATE . "${CMAKE_CURRENT_BINARY_DIR}")
  target_compile_options(${target}-tests PRIVATE /UNDEBUG /W4 /WX)
  add_test(NAME ${target} COMMAND ${target}-tests)
endforeach()
