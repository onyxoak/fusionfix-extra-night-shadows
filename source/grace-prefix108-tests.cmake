# Extract tested runtime bodies directly from the candidate and sealed105 references.
function(extract_grace108 input start end output)
 file(READ "${CMAKE_CURRENT_SOURCE_DIR}/${input}" body)
 string(FIND "${body}" "${start}" begin)
 if(begin LESS 0)
  message(FATAL_ERROR "108 extraction start missing: ${input}")
 endif()
 string(SUBSTRING "${body}" ${begin} -1 tail)
 string(FIND "${tail}" "${end}" finish)
 if(finish LESS 0)
  message(FATAL_ERROR "108 extraction end missing: ${input}")
 endif()
 string(SUBSTRING "${tail}" 0 ${finish} selected)
 file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/grace108/${output}" "${selected}")
endfunction()
