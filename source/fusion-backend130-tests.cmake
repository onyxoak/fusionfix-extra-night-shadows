file(READ "${CMAKE_CURRENT_SOURCE_DIR}/FusionBackend130Runtime.inc" BACKEND130_SOURCE)
string(FIND "${BACKEND130_SOURCE}" "// PREPARE_BOUNDARY130" BACKEND130_END)
if(BACKEND130_END LESS 1)
 message(FATAL_ERROR "130 actual production callback boundary missing")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/fusion-backend130-runtime.inc" "${BACKEND130_SOURCE}")
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/standalone-runtime.cpp" BACKEND130_INTEGRATION)
string(FIND "${BACKEND130_INTEGRATION}" "void VerifyBranch(" BACKEND130_GUARD_BEGIN)
string(FIND "${BACKEND130_INTEGRATION}" "std::vector<uint8_t> GuardedImage()" BACKEND130_GUARD_END)
math(EXPR BACKEND130_GUARD_LENGTH "${BACKEND130_GUARD_END}-${BACKEND130_GUARD_BEGIN}")
string(SUBSTRING "${BACKEND130_INTEGRATION}" ${BACKEND130_GUARD_BEGIN} ${BACKEND130_GUARD_LENGTH} BACKEND130_GUARD)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/fusion-backend130-verify.inc" "${BACKEND130_GUARD}")
string(FIND "${BACKEND130_INTEGRATION}" "void OnFrame(SafetyHookContext&) noexcept {\n FusionBackend130::Boundary();" BACKEND130_ENTRY)
if(BACKEND130_ENTRY LESS 1)
 message(FATAL_ERROR "130 restore service must precede every OnFrame failed-return")
endif()
foreach(test IN ITEMS fusion-backend130 fusion-backend130-runtime)
 add_executable(${test}-tests tests/${test}-tests.cpp)
 target_include_directories(${test}-tests BEFORE PRIVATE "${CMAKE_CURRENT_BINARY_DIR}" . external/safetyhook/include)
 target_compile_options(${test}-tests PRIVATE /UNDEBUG /W4 /WX)
 add_test(NAME ${test} COMMAND ${test}-tests)
endforeach()
