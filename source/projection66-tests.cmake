file(READ "${CMAKE_CURRENT_SOURCE_DIR}/NativeProjectionRuntime105.inc" PROJECTION66_SOURCE)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/LibertyLighting20Runtime.inc" PROJECTION66_COPY_SOURCE)
function(projection66_extract input begin end output)
 string(FIND "${${input}}" "${begin}" P66_BEGIN)
 string(FIND "${${input}}" "${end}" P66_END)
 if(P66_BEGIN LESS 0 OR P66_END LESS P66_BEGIN)
  message(FATAL_ERROR "Missing production projection66 extraction: ${output}")
 endif()
 math(EXPR P66_SIZE "${P66_END}-${P66_BEGIN}")
 string(SUBSTRING "${${input}}" ${P66_BEGIN} ${P66_SIZE} P66_TEXT)
 file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${output}" "${P66_TEXT}")
endfunction()
